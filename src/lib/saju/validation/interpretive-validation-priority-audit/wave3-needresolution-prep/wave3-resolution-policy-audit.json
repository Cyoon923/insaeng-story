    "notRequired": ["expertSurvey", "literatureValidation", "engineEnumRename"]
  },
  "reportAnswers": {
    "policyCharacter": {
      "RES-012": "product-semantic-label",
      "RES-013": "product-semantic-label",
      "RES-014": "product-semantic-label",
      "RES-015": "product-semantic-label"
    },
    "keepInternalNames": ["indeterminate", "single-axis", "convergent", "competing"],
    "uxNameOrCopyChangeNeeded": ["RES-012", "RES-013", "RES-014", "RES-015"],
    "mingliValidationRuleCount": 0,
    "canCloseWave3WithoutExperts": true
  }
